const SHEET = () => SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];

function rows_() {
  const v = SHEET().getDataRange().getValues();
  const h = v.shift();
  return v.map(r => Object.fromEntries(h.map((k, i) => [k, r[i]])));
}

// Kapag na-scan ang QR: ?no=PROPERTY_NO
function doGet(e) {
  const no = e.parameter.no;
  if (!no) {
    return ContentService.createTextOutput(JSON.stringify(rows_()))
      .setMimeType(ContentService.MimeType.JSON);
  }
  const p = rows_().find(r => String(r.property_no) === no);
  const esc = s => String(s ?? '').replace(/</g, '&lt;');
  const html = p
    ? `<meta name="viewport" content="width=device-width,initial-scale=1">
       <body style="font-family:sans-serif;padding:20px;max-width:480px;margin:auto">
       <h2>${esc(p.property_no)}</h2>
       <p><b>Articles:</b> ${esc(p.articles)}</p>
       <p><b>Location:</b> ${esc(p.location)}</p>
       <p><b>ICS:</b> ${esc(p.ics)}</p>
       <p><b>End User:</b> ${esc(p.end_user)}</p>
       <p><b>Accountable:</b> ${esc(p.accountable_person)}</p>
       <p><b>Date Acquired:</b> ${esc(p.date_acquired)}</p></body>`
    : `<body style="font-family:sans-serif;padding:20px"><h3>Property not found: ${esc(no)}</h3></body>`;
  return HtmlService.createHtmlOutput(html);
}

// Tumatanggap ng bagong/updated property galing sa app
function doPost(e) {
  const d = JSON.parse(e.postData.contents);
  const sh = SHEET();
  const h = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
  const row = h.map(k => d[k] ?? '');
  const nos = sh.getRange(2, 1, Math.max(sh.getLastRow() - 1, 1), 1).getValues().flat();
  const i = nos.indexOf(d.property_no);
  if (i >= 0) sh.getRange(i + 2, 1, 1, row.length).setValues([row]);
  else sh.appendRow(row);
  return ContentService.createTextOutput('ok');
}
